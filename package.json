    "webpack-cli": "5.1.4"
  },
  "electronmon": {
    "patterns": [
      "!app/**",
      "!lib/**",
      "!dist/**"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{json,css,md,yaml,yml}": "prettier --write"
  }
